# Secrets. .env.example shows the shape; the real token never gets committed.
.env

# Python
.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Generated by make_eink_video.py -- all reproducible from pictures/, and the
# API calls that produce them cost money, so they are kept out of the history
# rather than pushed and pulled around.
bw/
videos/

# Source photographs. Personal, and not needed to build anything.
# Anchored, so it does not also swallow epaper_video/pictures/.
/pictures/

# Stray media dropped in the project root.
/*.mp4
/*.jpeg
/*.JPG
/*.jpg

# Generated from pictures/ by make_eink_video.py.
epaper_video/clips.h

# Artifacts from the watercolour branch, kept out of the realistic run.
watercolor_run/

# CAD render packages. Rebuilt on demand by the CAD tooling from the .step.py
# sources next to them, and large.
__cadgen__/

# Elecrow's own STEP model of the board, fetched for the fit check. Theirs, not
# ours, and 8 MB -- case/README.md has the one command that gets it.
case/reference/
